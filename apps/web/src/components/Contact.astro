---
// Home page contact: the address, and the launch-list signup. The form only prints a reply locally
// (scripts/features/contact.ts); point that handler at a mailing-list provider when there is one.
import MailCopy from './MailCopy.astro';
---
<section id="contact">
  <h2>bring us a friction</h2>
  <p>tell us the everyday thing that takes you too long. the best ones become products. also open to partners, press, and other indie hackers: <MailCopy /></p>
  <p>to hear when something new comes off the line, leave an address and press enter. one message per launch. unsubscribe by replying "enough".</p>
  {/* no action or method yet: contact.ts handles the submit, and without JavaScript the form (and the
      paragraph above it, and #out) is hidden by the <noscript> styles in layouts/Base.astro, so it can
      never submit as a GET that puts the address in the URL. when a mailing-list provider exists, give
      the form its real action (method="post") and drop those hide rules. */}
  <form id="form" novalidate>
    <label for="email" aria-hidden="true">&gt;</label>
    <input type="email" id="email" name="email" autocomplete="email" spellcheck="false" placeholder="you@example.com" aria-label="your email address">
    <button type="submit">[ subscribe ]</button>
  </form>
  <pre id="out" class="dim" aria-live="polite"></pre>
</section>
