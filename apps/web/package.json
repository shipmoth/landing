  },
  "dependencies": {
    "@shipmoth/ascii-art": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "astro": "7.3.8",
    "htmlparser2": "9.1.0",
    "marked": "18.0.14",
    "typescript": "7.0.2"
  }
}
