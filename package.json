{
  "name": "shipmoth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:nginx": "turbo run //#nginx:test",
    "nginx:test": "pnpm -C apps/web exec playwright test -c playwright.nginx.config.ts"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  }
}
